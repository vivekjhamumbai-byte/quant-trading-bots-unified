# Broker Configuration (Shoonya/mStock)
MSTOCK_USER=
MSTOCK_PASSWORD=
MSTOCK_API_SECRET=

# Trading Configuration
TRADING_MODE=PAPER
ACCOUNT_CAPITAL=100000
MAX_LOSS_PER_TRADE=35000
MAX_LOSS_PER_DAY=500000
MAX_OPEN_POSITIONS=5

# Dashboard
DASHBOARD_PORT=8765
DASHBOARD_HOST=0.0.0.0

# Logging
LOG_LEVEL=INFO
LOG_DIR=logs

# VIX Filter
INDIA_VIX_THRESHOLD=16

# Feature Flags
ENABLE_LIVE_TRADING=0
ENABLE_PAPER_TRADING=1
ENABLE_BACKTEST=1
